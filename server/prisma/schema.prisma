generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

///////////////////////////////////////////////////////////
// USER
///////////////////////////////////////////////////////////

model User {
  id                        Int                 @id @default(autoincrement())
  employeeNumber            String              @unique
  firstName                 String
  lastName                  String
  email                     String              @unique
  phone                     String?
  password                  String
  roleId                    Int
  role                      Role                @relation(fields: [roleId], references: [id])
  isActive                  Boolean             @default(true)
  lastLogin                 DateTime?
  failedLoginAttempts       Int                 @default(0)
  passwordChangedAt         DateTime?
  settings                  Setting?
  customers                 Customer[]
  quotes                    Quote[]
  invoices                  Invoice[]
  payments                  Payment[]
  salesOrders               SalesOrder[]
  devices                   Device[]
  loginHistory              LoginHistory[]
  createdSuppliers          Supplier[]
  sessions                  UserSession[]
  notifications             Notification[]
  createdPurchaseOrders     PurchaseOrder[]     @relation("PurchaseOrderCreatedBy")
  approvedPurchaseOrders    PurchaseOrder[]     @relation("PurchaseOrderApprovedBy")
  cancelledPurchaseOrders   PurchaseOrder[]     @relation("PurchaseOrderCancelledBy")
  rejectedQuotes            Quote[]             @relation("QuoteRejectedBy")
  receivedGoodsReceipts     GoodsReceipt[]      @relation("GoodsReceiptReceivedBy")
  verifiedGoodsReceipts     GoodsReceipt[]      @relation("GoodsReceiptVerifiedBy")
  auditLogs                 AuditLog[]
  profileImage              String?
  emailVerified             Boolean             @default(false)
  createdInventoryMovements InventoryMovement[]
  createdStockCounts        StockCount[]
  createdWaybills           Waybill[]           @relation("WaybillCreatedBy")
  mustChangePassword        Boolean             @default(false)
  refundsProcessed          Refund[]            @relation("RefundProcessedBy")
  refundsApproved           Refund[]            @relation("RefundApprovedBy")
  refreshToken              String?
  postedJournalEntries      JournalEntry[]      @relation("JournalPostedBy")
  approvedSalesOrders       SalesOrder[]        @relation("SalesOrderApprovedBy")
  cancelledSalesOrders      SalesOrder[]        @relation("SalesOrderCancelledBy")
  deletedAt                 DateTime?
  requestedApprovals        Approval[]          @relation("RequestedBy")
  approvedApprovals         Approval[]          @relation("ApprovedBy")
  createdProducts           Product[]           @relation("ProductCreatedBy")
  updatedProducts           Product[]           @relation("ProductUpdatedBy")
  approvedQuotes            Quote[]             @relation("QuoteApprovedBy")
  approvedInvoices          Invoice[]           @relation("InvoiceApprovedBy")

  createdReports          Report[]  @relation("ReportCreatedBy")
  cancelledPayments       Payment[] @relation("PaymentCancelledBy")
  approvedPayments        Payment[] @relation("PaymentApprovedBy")
  loginAllowedFromMobile  Boolean   @default(true)
  loginAllowedFromDesktop Boolean   @default(true)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model DocumentSequence {
  id Int @id @default(autoincrement())

  type DocumentType

  year Int

  currentNumber Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([type, year])
}

enum DocumentType {
  CUSTOMER
  PRODUCT
  QUOTE
  SALES_ORDER
  INVOICE
  PAYMENT
  REFUND
  PURCHASE_ORDER
  GOODS_RECEIPT
  WAYBILL
}

model Role {
  id Int @id @default(autoincrement())

  name RoleName @unique

  displayName String

  description String?

  color String?

  isSystem Boolean @default(true)

  users User[]

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  SALES
  STORE_KEEPER
  ACCOUNTANT
}

model Permission {
  id Int @id @default(autoincrement())

  module String

  action PermissionAction

  name String @unique

  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  APPROVE
  REJECT
  PRINT
  EXPORT
  POST
  CANCEL
}

model RolePermission {
  roleId Int

  permissionId Int

  role Role @relation(fields: [roleId], references: [id])

  permission Permission @relation(fields: [permissionId], references: [id])

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
}

model AuditLog {
  id Int @id @default(autoincrement())

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  action String
  module AuditModule

  recordId     String?
  recordNumber String?

  oldValues Json?
  newValues Json?
  details   Json?

  ipAddress String?
  userAgent String?

  endpoint String?
  method   String?

  statusCode Int?

  createdAt DateTime @default(now())

  @@index([module])
  @@index([recordId])
  @@index([createdAt])
}

enum AuditModule {
  PAYMENT
  REFUND
  WAYBILL
  PURCHASE_ORDER
  GOODS_RECEIPT
  INVENTORY_COUNT
}

model Approval {
  id Int @id @default(autoincrement())

  module ApprovalModule

  recordId Int

  requestedById Int
  requestedBy   User @relation("RequestedBy", fields: [requestedById], references: [id])

  approvedById Int?
  approvedBy   User? @relation("ApprovedBy", fields: [approvedById], references: [id])

  status ApprovalStatus @default(PENDING)

  reason String?

  comments String?

  createdAt DateTime @default(now())

  approvedAt DateTime?
}

enum ApprovalStatus {
  PENDING

  APPROVED

  REJECTED

  CANCELLED
}

enum ApprovalModule {
  QUOTE

  INVOICE

  PAYMENT

  REFUND

  WAYBILL

  PURCHASE_ORDER

  GOODS_RECEIPT

  PRICE_OVERRIDE

  INVENTORY
}

model InventoryMovement {
  id Int @id @default(autoincrement())

  inventoryId Int
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  quantity Int

  quantityBefore Int

  quantityAfter Int

  movementType MovementType

  referenceType InventoryReferenceType

  referenceId Int

  remarks String?

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([inventoryId])
  @@index([createdAt])
}

model Inventory {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  quantity Int

  reservedQuantity Int @default(0)

  availableQuantity Int

  reorderLevel Int @default(20)

  movements InventoryMovement[]

  updatedAt DateTime @updatedAt

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
}

enum InventoryReferenceType {
  MANUAL
  PURCHASE_ORDER
  GOODS_RECEIPT
  SALES_ORDER
  INVOICE
  PAYMENT
  REFUND
  STOCK_COUNT
  TRANSFER
  WAYBILL
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id Int @id @default(autoincrement())

  purchaseOrderNumber String @unique

  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  createdById Int
  createdBy   User @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])

  approvedById Int?
  approvedBy   User? @relation("PurchaseOrderApprovedBy", fields: [approvedById], references: [id])

  cancelledById Int?
  cancelledBy   User? @relation("PurchaseOrderCancelledBy", fields: [cancelledById], references: [id])

  status PurchaseOrderStatus @default(DRAFT)

  supplierReference String?

  expectedDeliveryDate DateTime?

  receivedAt DateTime?

  deliveryAddress String?

  notes String?

  cancellationReason String?

  subtotal Float

  discount Float @default(0)

  tax Float @default(0)

  total Float

  items PurchaseOrderItem[]

  goodsReceipts GoodsReceipt[]

  isDeleted Boolean @default(false)

  approvedAt DateTime?

  cancelledAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([purchaseOrderNumber])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([status])
  @@index([createdById])
}

model PurchaseOrderItem {
  id Int @id @default(autoincrement())

  purchaseOrderId Int

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  productId Int

  product Product @relation(fields: [productId], references: [id])

  quantity Float

  receivedQuantity Float @default(0)

  unitCost Float

  discount Float @default(0)

  tax Float @default(0)

  total Float

  remarks String?

  goodsReceiptItems GoodsReceiptItem[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([purchaseOrderId])
  @@index([productId])
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLACKLISTED
}

model Supplier {
  id Int @id @default(autoincrement())

  name String

  companyName String?

  contactPerson String?

  email String?

  phone String

  address String?

  city String?

  state String?

  country String?

  notes String?

  status SupplierStatus @default(ACTIVE)

  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]

  isDeleted Boolean @default(false)

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([phone])
}

enum GoodsReceiptStatus {
  DRAFT
  RECEIVED
  VERIFIED
  CANCELLED
}

model GoodsReceipt {
  id Int @id @default(autoincrement())

  receiptNumber String @unique

  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  receivedById Int
  receivedBy   User @relation("GoodsReceiptReceivedBy", fields: [receivedById], references: [id])

  verifiedById Int?
  verifiedBy   User? @relation("GoodsReceiptVerifiedBy", fields: [verifiedById], references: [id])

  status GoodsReceiptStatus @default(RECEIVED)

  supplierInvoiceNumber String?

  supplierDeliveryNote String?

  truckNumber String?

  driverName String?

  remarks String?

  totalReceivedItems Int @default(0)

  totalRejectedItems Int @default(0)

  verifiedAt DateTime?

  isDeleted Boolean @default(false)

  items GoodsReceiptItem[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([receiptNumber])
  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([status])
}

model GoodsReceiptItem {
  id Int @id @default(autoincrement())

  goodsReceiptId Int
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id])

  purchaseOrderItemId Int
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  orderedQuantity Float

  receivedQuantity Float

  rejectedQuantity Float @default(0)

  acceptedQuantity Float

  unitCost Float

  remarks String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([goodsReceiptId])
  @@index([purchaseOrderItemId])
  @@index([productId])
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

model Warehouse {
  id Int @id @default(autoincrement())

  name String

  code String @unique

  description String?

  address String?

  city String?

  state String?

  country String?

  phone String?

  email String?

  managerName String?

  isPrimary Boolean @default(false)

  status WarehouseStatus @default(ACTIVE)

  inventories Inventory[]
  salesOrders SalesOrder[]

  purchaseOrders PurchaseOrder[]

  goodsReceipts GoodsReceipt[]

  stockCounts StockCount[]

  waybills Waybill[]

  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([code])
  @@index([status])
}

enum MovementType {
  PURCHASE

  SALE

  RETURN

  REFUND

  TRANSFER

  ADJUSTMENT

  COUNT

  DAMAGED

  LOST

  RESERVED

  RELEASED
}

enum CountStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DriverStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  INACTIVE
}

enum WaybillStatus {
  PENDING
  LOADING
  IN_TRANSIT
  DELIVERED
  RETURNED
  CANCELLED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountingSource {
  SALES_ORDER
  QUOTE
  INVOICE
  PAYMENT
  REFUND
  INVENTORY
  MANUAL
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
}

model StockCount {
  id Int @id @default(autoincrement())

  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  startedById Int
  startedBy   User      @relation(fields: [startedById], references: [id])

  status CountStatus

  createdAt DateTime @default(now())

  completedAt DateTime?
}

model Vehicle {
  id Int @id @default(autoincrement())

  registrationNumber String @unique

  fleetNumber String @unique

  make String

  model String

  year Int?

  capacity Float

  capacityUnit String

  waybills Waybill[]
  status   VehicleStatus

  currentMileage Int @default(0)

  gpsDeviceId String?

  assignedDriverId Int?

  assignedDriver Driver? @relation("AssignedDriver", fields: [assignedDriverId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([status])
}

enum VehicleStatus {
  AVAILABLE

  LOADING

  ON_DELIVERY

  MAINTENANCE

  OUT_OF_SERVICE
}

model Driver {
  id Int @id @default(autoincrement())

  employeeNumber String @unique

  firstName String

  lastName String

  phone String

  licenseNumber String

  licenseExpiry DateTime

  status DriverStatus

  assignedVehicles Vehicle[] @relation("AssignedDriver")

  waybills Waybill[]

  createdAt DateTime @default(now())
}

model Waybill {
  id Int @id @default(autoincrement())

  waybillNumber String @unique

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  vehicleId Int
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  driverId Int
  driver   Driver @relation(fields: [driverId], references: [id])

  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  createdBy User          @relation("WaybillCreatedBy", fields: [createdById], references: [id])
  items     WaybillItem[]

  destination String

  status WaybillStatus

  dispatchedAt DateTime?

  deliveredAt DateTime?

  verificationCode String @unique

  signature String

  createdById Int

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([waybillNumber])
  @@index([status])
}

model WaybillItem {
  id Int @id @default(autoincrement())

  waybillId Int
  waybill   Waybill @relation(fields: [waybillId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  quantity Int

  weight Float?
}

model Account {
  id Int @id @default(autoincrement())

  accountCode String @unique

  name String

  type AccountType

  parentId Int?

  parent Account? @relation("ChartHierarchy", fields: [parentId], references: [id])

  children Account[] @relation("ChartHierarchy")

  journalLines JournalLine[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
}

model JournalEntry {
  id Int @id @default(autoincrement())

  reference String

  description String

  sourceModule AccountingSource

  sourceId Int

  postedById Int

  postedBy User @relation("JournalPostedBy", fields: [postedById], references: [id])

  postedAt DateTime @default(now())

  lines JournalLine[]

  @@index([postedAt])
}

model JournalLine {
  id Int @id @default(autoincrement())

  journalEntryId Int
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  accountId Int
  account   Account @relation(fields: [accountId], references: [id])

  debit Float @default(0)

  credit Float @default(0)
}

model Refund {
  id Int @id @default(autoincrement())

  refundNumber String @unique

  verificationCode String @unique

  paymentId Int
  payment   Payment @relation(fields: [paymentId], references: [id])

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  amount Float

  refundMethod RefundMethod

  reason String

  notes String?

  status RefundStatus @default(PENDING)

  approvedAt DateTime?

  rejectionReason String?

  approvedById Int?
  approvedBy   User? @relation("RefundApprovedBy", fields: [approvedById], references: [id])

  processedById Int?
  processedBy   User? @relation("RefundProcessedBy", fields: [processedById], references: [id])

  createdAt DateTime @default(now())
}

enum RefundMethod {
  CASH
  TRANSFER
  CARD
  CHEQUE
  OTHER
}

model SalesOrder {
  id Int @id @default(autoincrement())

  orderNumber String @unique

  quoteId Int?

  quote Quote? @relation(fields: [quoteId], references: [id])

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  createdById Int
  createdBy   User  @relation(fields: [createdById], references: [id])
  deliveryFee Float @default(0)

  labourFee     Float       @default(0)
  status        OrderStatus @default(PENDING)
  invoice       Invoice?
  approvedById  Int?
  approvedBy    User?       @relation("SalesOrderApprovedBy", fields: [approvedById], references: [id])
  cancelledById Int?
  cancelledBy   User?       @relation("SalesOrderCancelledBy", fields: [cancelledById], references: [id])
  warehouseId Int?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  approvedAt  DateTime?
  cancelledAt DateTime?

  cancellationReason String?

  deliveryAddress String?

  deliveryInstructions String?

  expectedDeliveryDate DateTime?

  isDeleted Boolean @default(false)

  subtotal Float
  discount Float
  tax      Float
  total    Float

  notes String?

  items SalesOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SalesOrderItem {
  id Int @id @default(autoincrement())

  orderId Int
  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  quantity Int

  unitPrice Float

  negotiatedPrice Float?

  total Float
}

enum OrderStatus {
  PENDING
  APPROVED
  PROCESSING
  READY_FOR_LOADING
  LOADED
  DISPATCHED
  DELIVERED
  CANCELLED
}

///////////////////////////////////////////////////////////
// CUSTOMER
///////////////////////////////////////////////////////////
enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model Customer {
  id Int @id @default(autoincrement())

  customerNumber String @unique

  name String

  companyName String?

  email String?

  phone String?

  address String?

  city String?

  state String?

  country String?

  status CustomerStatus @default(ACTIVE)

  outstandingBalance Decimal @default(0) @db.Decimal(18, 2)

  notes String?

  isDeleted Boolean @default(false)

  createdById Int

  createdBy User @relation(fields: [createdById], references: [id])

  quotes Quote[]

  invoices Invoice[]

  payments Payment[]

  salesOrders SalesOrder[]

  refunds Refund[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([phone])
  @@index([email])
  @@index([createdById])
}

model Device {
  id Int @id @default(autoincrement())

  userId Int

  user User @relation(fields: [userId], references: [id])

  deviceName String

  deviceId String @unique

  platform String

  lastLogin DateTime?

  trusted Boolean @default(false)

  createdAt DateTime @default(now())
}

model LoginHistory {
  id Int @id @default(autoincrement())

  userId Int

  user User @relation(fields: [userId], references: [id])

  device String?

  browser String?

  ip String?

  location String?

  successful Boolean

  createdAt DateTime @default(now())
}

model UserSession {
  id Int @id @default(autoincrement())

  token String @unique

  expiresAt DateTime

  lastSeen DateTime?

  userId Int

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model Notification {
  id Int @id @default(autoincrement())

  title String

  message String

  type String

  isRead Boolean @default(false)

  userId Int

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

///////////////////////////////////////////////////////////
// PRODUCT
///////////////////////////////////////////////////////////

model Product {
  id Int @id @default(autoincrement())

  productNumber String @unique

  name String

  description String?

  sku String? @unique

  barcode String? @unique

  purchaseOrderItems PurchaseOrderItem[]

  goodsReceiptItems GoodsReceiptItem[]

  salesOrderItems SalesOrderItem[]

  quoteItems QuoteItem[]

  invoiceItems InvoiceItem[]
  inventories  Inventory[]

  waybillItems WaybillItem[]

  unit ProductUnit

  costPrice Decimal @db.Decimal(18, 2)

  sellingPrice Decimal @db.Decimal(18, 2)

  currentStock Decimal @default(0) @db.Decimal(18, 2)

  reservedStock Decimal @default(0) @db.Decimal(18, 2)

  minimumStock Decimal @default(0) @db.Decimal(18, 2)

  reorderLevel Decimal @default(0) @db.Decimal(18, 2)

  expiryDate    DateTime?
  hasExpiryDate Boolean   @default(false)
  imageUrl      String?

  isActive Boolean @default(true)

  isDeleted Boolean @default(false)

  createdById Int

  createdBy User @relation("ProductCreatedBy", fields: [createdById], references: [id])

  updatedById Int?

  updatedBy User? @relation("ProductUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([productNumber])
}

enum ProductUnit {
  BAG
  PIECE
  ROD
  ROLL
  BUNDLE
  CARTON
  KG
  LITRE
  TON
}

///////////////////////////////////////////////////////////
// QUOTE
///////////////////////////////////////////////////////////

model Quote {
  id Int @id @default(autoincrement())

  quoteNumber String @unique

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  status QuoteStatus @default(DRAFT)

  subtotal Float
  tax      Float @default(0)
  discount Float @default(0)
  total    Float

  validUntil DateTime?
  notes      String?

  items       QuoteItem[]
  salesOrders SalesOrder[]

  isDeleted Boolean @default(false)

  verificationCode String @unique

  approvedById Int?
  approvedBy   User? @relation("QuoteApprovedBy", fields: [approvedById], references: [id])

  approvedAt DateTime?

  rejectedById Int?
  rejectedBy   User? @relation("QuoteRejectedBy", fields: [rejectedById], references: [id])

  rejectedAt DateTime?

  approvalNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quoteNumber])
  @@index([customerId])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

///////////////////////////////////////////////////////////
// QUOTE ITEM
///////////////////////////////////////////////////////////

model QuoteItem {
  id Int @id @default(autoincrement())

  quoteId Int
  quote   Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  quantity Int

  unitPrice Float

  negotiatedPrice Float?

  discount Float @default(0)

  total Float

  remarks String?

  createdAt DateTime @default(now())
}

model Invoice {
  id Int @id @default(autoincrement())

  invoiceNumber String @unique

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  status InvoiceStatus @default(UNPAID)

  subtotal Float

  deliveryFee Float @default(0)

  labourFee Float @default(0)

  tax Float @default(0)

  discount Float @default(0)

  total Float

  dueDate DateTime?

  notes String?

  items        InvoiceItem[]
  salesOrderId Int?          @unique
  salesOrder   SalesOrder?   @relation(fields: [salesOrderId], references: [id])

  waybills Waybill[]

  refunds    Refund[]
  amountPaid Float    @default(0)

  balance Float

  paymentStatus    InvoicePaymentStatus @default(UNPAID)
  payments         Payment[]
  verificationCode String               @unique

  approvedById Int?
  approvedBy   User? @relation("InvoiceApprovedBy", fields: [approvedById], references: [id])

  approvedAt DateTime?

  approvalNote String?

  isPrinted Boolean @default(false)

  printedAt DateTime?

  isDeleted  Boolean          @default(false)
  isApproved Boolean          @default(false)
  services   InvoiceService[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([invoiceNumber])
  @@index([customerId])
  @@index([status])
}

enum InvoicePaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

model InvoiceItem {
  id Int @id @default(autoincrement())

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  quantity Int

  unitPrice Float

  total Float
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum InvoiceServiceType {
  DELIVERY
  LABOUR
}

model InvoiceService {
  id Int @id @default(autoincrement())

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  type InvoiceServiceType

  description String?

  quantity Float @default(1)

  unitPrice Float

  total Float

  createdAt DateTime @default(now())
}

///////////////////////////////////////////////////////////
// PAYMENT
///////////////////////////////////////////////////////////

model Payment {
  id Int @id @default(autoincrement())

  paymentNumber String @unique

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  cancelledById Int?
  cancelledBy   User?    @relation("PaymentCancelledBy", fields: [cancelledById], references: [id])
  refunds       Refund[]
  approvedById  Int?
  approvedBy    User?    @relation("PaymentApprovedBy", fields: [approvedById], references: [id])
  amount        Float

  paymentMethod PaymentMethod

  status PaymentStatus

  approvedAt DateTime?

  cancelledAt DateTime?

  cancellationReason String?

  receivedDate DateTime @default(now())

  receiptNumber String?

  verificationCode String @unique

  transactionId String?

  notes String?

  refundedAmount Float @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

enum PaymentMethod {
  TRANSFER
  CASH
  CARD
  CHEQUE
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum FontSize {
  SMALL
  MEDIUM
  LARGE
}

enum TableDensity {
  COMFORTABLE
  COMPACT
  SPACIOUS
}

model Setting {
  id Int @id @default(autoincrement())

  // Business
  companyName        String
  industry           String?
  registrationNumber String?
  taxNumber          String?

  email   String?
  phone   String?
  website String?

  address String?
  city    String?
  state   String?
  country String?

  // Finance
  currency       String @default("NGN")
  currencySymbol String @default("₦")

  tax Float @default(0)

  quotePrefix   String @default("QT")
  invoicePrefix String @default("INV")
  paymentPrefix String @default("PAY")
  expensePrefix String @default("EXP")

  quoteValidity  Int @default(30)
  invoiceDueDays Int @default(30)

  decimalPlaces Int @default(2)

  // Appearance
  theme            Theme   @default(SYSTEM)
  primaryColor     String  @default("#2563eb")
  compactMode      Boolean @default(false)
  sidebarCollapsed Boolean @default(false)

  fontSize     FontSize     @default(MEDIUM)
  tableDensity TableDensity @default(COMFORTABLE)

  companyLogo String?

  timezone String @default("Africa/Lagos")

  dateFormat String @default("DD/MM/YYYY")

  timeFormat String @default("24H")

  createdById Int  @unique
  createdBy   User @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Schema for storing report definitions and cached results
model Report {
  id          Int           @id @default(autoincrement())
  name        String
  type        String // "sales", "inventory", "financial"
  filters     Json
  generatedAt DateTime      @default(now())
  createdById Int
  createdBy   User          @relation("ReportCreatedBy", fields: [createdById], references: [id])
  results     ReportResult?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([createdById])
}

model ReportResult {
  id          Int      @id @default(autoincrement())
  reportId    Int      @unique
  report      Report   @relation(fields: [reportId], references: [id])
  data        Json
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([reportId])
}
// Operating expenses (marketing, fuel, staff, repairs, utilities, etc.)
model Expense {
  id          Int      @id @default(autoincrement())
  description String
  category    ExpenseCategory
  amount      Float
  date        DateTime @default(now())
  reference   String?  // invoice or payment reference
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([category])
}

enum ExpenseCategory {
  TRANSPORTATION
  FUEL
  STAFF
  REPAIRS
  MARKETING
  UTILITIES
  OTHER
}

// Budget for revenue, expenses, profit by month/year
model Budget {
  id          Int      @id @default(autoincrement())
  month       Int      // 1-12
  year        Int
  revenue     Float    @default(0)
  expenses    Float    @default(0)
  profit      Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([month, year])
}